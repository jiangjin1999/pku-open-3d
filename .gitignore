# Track the maintained release; local research and old previews remain local.
/*
!/.github/
!/.gitattributes
!/.gitignore
!/AGENTS.md
!/README.md
!/README.zh-CN.md
!/CONTRIBUTING.md
!/CONTRIBUTING.zh-CN.md
!/LICENSE
!/DATA_LICENSE.md
!/CHANGELOG.md
!/VERSION
!/package.json
!/package-lock.json
!/app/
!/scripts/
!/docs/
!/community/
!/ops/
!/models/
!/pyproject.toml
!/uv.lock
!/CLAUDE.md
!/UPSTREAM.json
!/COMMUNITY_LICENSE.md
!/SECURITY.md
!/docs/*.md
.DS_Store
__pycache__/
*.pyc
node_modules/
.env
.env.*
*.key
*.pem
/app/assets/
/app/evidence/
/app/docs
/docs/*
!/docs/media/
!/docs/development/
!/docs/DEVELOPMENT.md
!/docs/DEVELOPMENT.zh-CN.md
!/docs/SOURCES.md
!/docs/SOURCES.zh-CN.md
!/docs/LICENSING.md

/app/private/
/app/data/*reference*
/app/data/*audit*
/app/data/*download*
/app/data/*review*
/app/data/input/evidence/
/app/tools/*
!/app/tools/bake-scene46.cjs
!/app/tools/scene-collector46.js

# Evidence-specific recipes and regression archives stay on the development machine.
/app/prepare_data.py
/app/data/*
!/app/data/campus.json
!/app/data/architecture-inventory.json
!/app/data/scene-atlas-baseline46.json
/app/tests/*
!/app/tests/fixtures/
!/app/tests/draw-merge46.test.cjs
!/app/tests/geometry.test.cjs
!/app/tests/instance-stream46.test.cjs
!/app/tests/routing.test.cjs
!/app/tests/scene-cache46.test.cjs
!/app/tests/visibility-cache46.test.cjs
!/app/tests/visibility-groups46.test.cjs
!/app/tests/visibility.test.cjs
!/app/tests/adjacent-draw46.test.cjs
!/app/tests/instance-transfer46.test.cjs
!/app/tests/provoking-vertex46.test.cjs
!/app/tests/scene-unshuffle46.test.cjs
!/app/tests/uniform-cache46.test.cjs
!/app/tests/visibility-direct-stream46.test.cjs
!/app/tests/visibility-scratch46.test.cjs
/app/tests/fixtures/building117-unbatched.js

