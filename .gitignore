!/app/tests/scene-upload-budget46.test.cjs
# Community runtime and private source material
.local/
.venv/
.env
.env.*
!.env.example
community/web/app.js
community/web/preview.js
community/web/*.map
community/web/campus.jpg
community/web/campus-evening.jpg
community/web/THIRD_PARTY.txt
__pycache__/
.pytest_cache/
.coverage
*.sqlite3*
private-sources/
